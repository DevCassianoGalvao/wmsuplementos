# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_NAME="Maia Suplementos"
APP_URL=https://www.cassianogalvao.com/maiasuplementos
APP_DEBUG=false

# ── Banco de dados ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maia_suplementos
DB_USER=db_user
DB_PASS=db_password
DB_CHARSET=utf8mb4

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ── Brevo (e-mail transacional) ───────────────────────────────────────────────
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
BREVO_LIST_ID=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=contato@maiasuplementos.com.br
MAIL_FROM_NAME="Maia Suplementos"

# ── Upload ────────────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880

# ── Sessão ────────────────────────────────────────────────────────────────────
SESSION_NAME=maia_sess
