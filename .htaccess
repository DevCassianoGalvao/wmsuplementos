<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /maiasuplementos/

    # Se já chegou em public/ — para (evita loop)
    RewriteRule ^public/ - [L]

    # Tudo mais → public/
    # O public/.htaccess cuida de servir arquivos reais ou rotear para index.php
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

Options -Indexes
